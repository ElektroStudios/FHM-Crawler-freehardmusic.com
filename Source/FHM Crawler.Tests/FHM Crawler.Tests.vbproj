<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FHM Crawler.Tests</AssemblyName>
    <RootNamespace>FHMCrawler.Tests</RootNamespace>
    <!-- The test assembly does not need the auto-generated "My" namespace. -->
    <MyType>Empty</MyType>
    <LangVersion>latest</LangVersion>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <!-- Same version as the application project (packages.config); ensures the crawler finds it at test run time. -->
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <!-- Allows building without the .NET Framework 4.8 targeting pack installed (e.g. CI agents). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FHM Crawler\FHM Crawler.vbproj" />
  </ItemGroup>

</Project>
